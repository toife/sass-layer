{
  "name": "@toife/sass-layer-generator",
  "version": "1.0.9",
  "description": "Sass layer generator - utilities for design tokens, utility classes, and theme generation",
  "type": "module",
  "sideEffects": true,
  "exports": {
    ".": {
      "sass": "./index.scss"
    }
  },
  "sass": "./index.scss",
  "files": [
    "index.scss",
    "config",
    "functions",
    "mixins",
