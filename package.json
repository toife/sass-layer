    "scss",
    "design-tokens",
    "utility-classes",
    "theme",
    "css",
    "toife"
  ],
  "author": "Toikit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/toife/sass-layer-generator"
  },
  "peerDependencies": {
    "sass": ">=1.50.0"
  }
}
